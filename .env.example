# Injected automatically from package.json by Vite; override only if needed.
VITE_APP_VERSION=1.2.0

# Required for real summaries (free key from https://aistudio.google.com/apikey).
# Used by Vercel /api/summarize, Vite dev middleware, and Electron when not using VIDMD_API_URL.
GEMINI_API_KEY=

# Optional Gemini model override (default: gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash

# Optional: Electron main process calls the cloud API instead of local Gemini.
# Example: https://your-app.vercel.app
VIDMD_API_URL=
