{
  "name": "vidmd",
  "version": "1.1.0",
  "description": "Vid.md — summarize YouTube videos into Markdown via cloud AI",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "author": "Vid.md",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-electron-pkg.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.vidmd.app",
    "productName": "Vid.md",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Vid.md-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@vercel/node": "^5.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
